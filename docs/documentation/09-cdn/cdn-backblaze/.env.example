# Backblaze B2 Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - only commit this .env.example file

# Backblaze Master Key ID
B2_MASTER_KEY_ID=your_master_key_id_here

# Backblaze Application Key ID
B2_APPLICATION_KEY_ID=your_application_key_id_here

# Backblaze Application Key
B2_APPLICATION_KEY=your_application_key_here

# Bucket Name
B2_BUCKET_NAME=kolkrabbi

# S3-compatible endpoint
B2_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_S3_REGION=us-west-002

# CDN URL (public read URL)
CDN_BASE_URL=https://f005.backblazeb2.com/file/kolkrabbi/website
