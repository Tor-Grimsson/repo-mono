# Link in-repo @kol/* packages from the workspace instead of the npm registry.
# yarn 1 linked workspace packages by name+range; pnpm 10 defaults this off.
# Turning it on preserves the existing semver ranges without rewriting every
# package.json. (workspace:* protocol is a later cleanup.)
link-workspace-packages=true

# Keep pnpm's default isolated/symlinked layout (web + brand build clean on it,
# and it preserves esbuild's binary + opentype.js CJS interop). Sanity
# (apps/studio) and its plugins import React / styled-components / emotion from
# transitive packages without declaring them, which strict isolation can't
# resolve. Hoist ONLY those singletons to the root node_modules so Sanity finds
# them — without the collateral of shamefully-hoist (which broke web's opentype
# resolution). Single React is still guaranteed by pnpm.overrides.
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*styled-components*
public-hoist-pattern[]=@emotion/*
