{
  "name": "kolkrabbi-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:video": "turbo run dev --filter=video",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "metrics:styleguide": "node scripts/generate-styleguide-metrics.js"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "playwright": "^1.58.2",
    "prettier": "^3.3.3",
    "turbo": "^1.13.0"
  }
}
