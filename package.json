{
  "name": "kolkrabbi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=studio --filter=brand",
    "dev:web": "turbo run dev --filter=web",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:brand": "turbo run dev --filter=brand",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "metrics:styleguide": "node scripts/generate-styleguide-metrics.js"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "playwright": "^1.58.2",
    "prettier": "^3.3.3",
    "turbo": "^1.13.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@kolkrabbi/kol-component": "^0.68.1",
      "@kolkrabbi/kol-framework": "^0.23.0",
      "@kolkrabbi/kol-theme": "0.51.0",
      "@kolkrabbi/kol-icons": "^0.18.0"
    }
  }
}
