{
  "name": "kolkrabbi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=studio --filter=brand",
    "dev:web": "turbo run dev --filter=web",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:video": "turbo run dev --filter=video",
    "dev:brand": "turbo run dev --filter=brand",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "metrics:styleguide": "node scripts/generate-styleguide-metrics.js"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "playwright": "^1.58.2",
    "prettier": "^3.3.3",
    "turbo": "^1.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
