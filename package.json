{
  "name": "kolkrabbi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=studio --filter=brand",
    "dev:web": "turbo run dev --filter=web",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:brand": "turbo run dev --filter=brand",
    "dev:metrics": "turbo run dev --filter=metrics",
    "dev:media": "turbo run dev --filter=media",
    "media:cf": "pnpm --filter media dev:cf",
    "media:deploy": "pnpm --filter media run deploy",
    "media:cdn-deploy": "pnpm --filter media run deploy:cdn",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "metrics:styleguide": "node scripts/generate-styleguide-metrics.js"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "turbo": "^1.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
