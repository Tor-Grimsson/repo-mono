# Sanity project configuration for Vercel (copy values from your local .env/.env.local)
VITE_SANITY_PROJECT_ID=yourProjectId
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01
VITE_SANITY_USE_CDN=true
# Optional token required for preview/draft access (leave blank if unused)
VITE_SANITY_PREVIEW_TOKEN=
