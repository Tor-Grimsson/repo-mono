                {/* Mobile: Icon only */}
                <div className="space-y-2">
                  <div className="kol-mono-xs opacity-60">Mobile</div>
                  <button
                    onClick={() => toggleButton('primary-default-mobile')}
                    aria-label="Toggle theme"
                    className={`theme-toggle-horizontal ${buttonStates['primary-default-mobile'] ? 'toggled' : ''}`}
                    style={{
                      background: 'none',
                      border: 'none',
                      padding: 0,
                      cursor: 'pointer',
                      color: 'var(--component-fg)',
                      display: 'inline-flex',
                      alignItems: 'center',
                      justifyContent: 'center'
                    }}
                  >
                    <span
                      className="icon-swap-container"
                      style={{
                        position: 'relative',
                        display: 'inline-flex',
                        alignItems: 'center',
