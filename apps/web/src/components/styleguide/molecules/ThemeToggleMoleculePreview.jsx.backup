import { useState } from 'react'
import { ThemeToggle, Button, Icon, ThemeToggleButton } from '@kol/ui'

const variants = [
  { id: 'default', label: 'Default' },
  { id: 'compact', label: 'Compact' }
]

const breakpoints = [
  { id: 'mobile', label: 'Mobile', fontSize: '14px', iconSize: 14, padding: '8px 20px', iconOnlyPadding: '8px', buttonWidth: '160px' },
  { id: 'tablet', label: 'Tablet', fontSize: '16px', iconSize: 16, padding: '12px 28px', iconOnlyPadding: '12px', buttonWidth: '180px' },
  { id: 'desktop', label: 'Desktop', fontSize: '18px', iconSize: 18, padding: '14px 32px', iconOnlyPadding: '14px', buttonWidth: '200px' }
]

export default function ThemeToggleMoleculePreview() {
  const [remakeTheme, setRemakeTheme] = useState('light')
  const [isToggled, setIsToggled] = useState(false)

  // Independent states for each button using object
  const [buttonStates, setButtonStates] = useState({})

  const toggleButton = (id) => {
    setButtonStates(prev => ({
      ...prev,
      [id]: !prev[id]
    }))
  }

  const toggleRemake = () => {
    setRemakeTheme(prev => prev === 'dark' ? 'light' : 'dark')
    setIsToggled(prev => !prev)
  }

  return (
    <>
      <style>{`
        .theme-toggle-horizontal .icon-swap-container > svg:first-child {
          transform: translateX(0) rotate(0deg);
        }
        .theme-toggle-horizontal .icon-swap-container > svg:last-child {
          transform: translateX(-100%) rotate(0deg);
        }
        .theme-toggle-horizontal.toggled .icon-swap-container > svg:first-child {
          transform: translateX(100%) rotate(180deg);
        }
        .theme-toggle-horizontal.toggled .icon-swap-container > svg:last-child {
          transform: translateX(0) rotate(180deg);
        }
        .theme-toggle-horizontal:hover {
          border-color: color-mix(in srgb, var(--foreground) 60%, transparent) !important;
        }
      `}</style>
      <div className="space-y-12">
        {/* New ThemeToggleButton Component */}
        <div className="space-y-6">
          <div>
            <h3 className="kol-heading-sm mb-2">ThemeToggleButton Component (Live)</h3>
            <p className="kol-mono-xs opacity-60">
              Production-ready component with responsive behavior and click animation
            </p>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Primary Surface */}
            <div
              className="rounded-lg p-8 space-y-8 opacity-10-border"
              style={{
                backgroundColor: 'var(--surface-primary)',
                color: 'var(--foreground)',
                borderWidth: '1px',
                borderStyle: 'solid',
                borderColor: 'color-mix(in srgb, var(--foreground) 10%, transparent)'
              }}
            >
              <div className="space-y-3">
                <div className="kol-mono-xs">Default Variant</div>
                <ThemeToggleButton
                  variant="default"
                  isToggled={remakeTheme === 'dark'}
                  onClick={toggleRemake}
                />
              </div>

              <div className="space-y-3">
                <div className="kol-mono-xs">Compact Variant</div>
                <ThemeToggleButton
                  variant="compact"
                  isToggled={remakeTheme === 'dark'}
                  onClick={toggleRemake}
                />
              </div>
            </div>

            {/* Inverse Surface */}
            <div className="rounded-lg p-8 space-y-8 surface-inverse">
              <div className="space-y-3">
                <div className="kol-mono-xs">Default Variant</div>
                <ThemeToggleButton
                  variant="default"
                  isToggled={remakeTheme === 'dark'}
                  onClick={toggleRemake}
                />
              </div>

              <div className="space-y-3">
                <div className="kol-mono-xs">Compact Variant</div>
                <ThemeToggleButton
                  variant="compact"
                  isToggled={remakeTheme === 'dark'}
                  onClick={toggleRemake}
                />
              </div>
            </div>
          </div>
        </div>

        {/* Button-based Remake */}
        <div className="space-y-6">
        <div>
          <h3 className="kol-heading-sm mb-2">Theme Toggle (Button-based Remake)</h3>
          <p className="kol-mono-xs opacity-60">
